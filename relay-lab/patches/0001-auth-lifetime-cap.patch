+/* Monotonic milliseconds for authorization deadlines. Wall-clock time
+ * (turn_time/time(NULL)) can roll back; a frozen deadline measured with
+ * this clock cannot be re-granted by Refresh or by a clock correction.
+ *
+ * TURN_MONOTONIC_MS_FAIL is returned when CLOCK_MONOTONIC is unavailable
+ * or clock_gettime fails. There is NO wall-clock fallback: callers must
+ * fail closed and deny new/renewed authority. Never conflate this failure
+ * with deadline 0 (no-bound / unlimited). */
+#define TURN_MONOTONIC_MS_FAIL ((int64_t)INT64_MIN)
+
+/* Frozen authorization deadline sentinel meaning "clock fault or invalid
+ * deadline; deny new and renewed authority". Distinct from 0 (no deadline).
+ * Negative deadlines other than 0 must also fail closed in callers. */
+#define TURN_AUTH_DEADLINE_FAIL ((int64_t)INT64_MIN)
+
+static inline int64_t turn_monotonic_ms(void) {
+#if defined(TURN_TEST_CLOCK_FAULT)
+  /* Test-only build seam (compile-time). Simulates monotonic clock failure
+   * in the real binary; not a runtime hook and not exported. */
+  return TURN_MONOTONIC_MS_FAIL;
+#elif defined(CLOCK_MONOTONIC)
+  struct timespec ts;
+  if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) {
+    /* Checked conversion: reject values that would overflow int64 ms. */
+    if (ts.tv_sec < 0 || ts.tv_sec > (INT64_MAX / 1000)) {
+      return TURN_MONOTONIC_MS_FAIL;
+    }
+    return ((int64_t)ts.tv_sec) * 1000 + (int64_t)(ts.tv_nsec / 1000000);
+  }
+  return TURN_MONOTONIC_MS_FAIL;
+#else
+  /* Supported platforms (Linux/macOS) provide CLOCK_MONOTONIC. Absence is
+   * a fault, never a wall-clock fallback. */
+  return TURN_MONOTONIC_MS_FAIL;
+#endif
+}
